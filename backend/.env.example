# FEEDSURGE API — configure values in your hosting provider, never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=surgevideos
R2_PUBLIC_URL=https://YOUR_R2_PUBLIC_HOST
FRONTEND_URLS=https://YOUR_FEEDSURGE_DOMAIN
PORT=10000

# Square one-time 30-day membership checkout and signed webhooks
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2025-10-16
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://YOUR_API_HOST/api/webhooks/square

# Comma-separated exact owner login email(s); never use a public client-side flag
FEEDSURGE_OWNER_EMAILS=
